# Copy this file to .env.local and fill in real values. Never commit .env.local.

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook ID from the sandbox app's webhook settings (used to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# AI provider (gemini for now; kept swappable)
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Check aistudio.google.com for the current model names
GEMINI_MODEL=gemini-3.8-flash

# Where the SQLite database file lives (optional)
DATABASE_PATH=./tabby.db

# Where delivered files are saved (optional, default ./uploads)
UPLOAD_DIR=./uploads

# How long the client has to review delivered work before a VERIFIED
# delivery can be released without them. Default 72 (3 days).
# For a demo, try 0.05 (= 3 minutes).
REVIEW_PERIOD_HOURS=72
