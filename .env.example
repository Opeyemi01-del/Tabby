# Copy this file to .env.local and fill in real values. Never commit .env.local.

# PayPal sandbox app credentials (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Webhook ID from the sandbox app's webhook settings (used to verify webhook signatures)
PAYPAL_WEBHOOK_ID=

# AI provider (gemini for now; kept swappable)
AI_PROVIDER=gemini
GEMINI_API_KEY=
